---
import HeroVideo from '/videos/istockphoto-2187652535-640_adpp_is.mp4';
import { Image } from 'astro:assets'; 
import HeartIcon from '/imgs/love-512x512.png';
---

<div class="relative w-full aspect-[9/16] overflow-hidden flex flex-col
    flex items-center justify-center gap-16">

    <!-- Background Video -->
    <video 
      class="absolute inset-0 object-cover z-0 aspect-[9/16] w-full
        flex items-center justify-center"
      autoplay muted loop playsinline>
      <source src={HeroVideo} type="video/mp4">
    </video>

    <!-- Overlay Content -->
    <div class="relative z-10 bg-white/15 text-center p-4 rounded">
      <h1 class="animate-pulse font-bold text-[8vw] text-pink-500">* Pony Heaven *</h1>
      <p class="text-pink-400">My (mostly secret) blogging site</p>
    </div>

    <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4">
        <Image src={img1} alt="Description 1" class="w-full aspect-square object-cover rounded-lg" />
        <Image src={img2} alt="Description 2" class="w-full aspect-square object-cover rounded-lg" />
        <Image src={img3} alt="Description 3" class="w-full aspect-square object-cover rounded-lg" />
    </div> -->

    <div class="relative max-auto grid grid-cols-1 gap-16 justify-items-center">
    <!-- <div class="relative z-10 text-center p-4 rounded"> -->
        <Image src={HeartIcon} alt="Heart icon in red" class="opacity-70 w-15 aspect-square object-cover"/>
        <Image src={HeartIcon} alt="Heart icon in red" class="opacity-60 w-10 aspect-square"/>
        <Image src={HeartIcon} alt="Heart icon in red" class="opacity-40 w-5 aspect-square"/>

        <!-- BLOG BUTTON -->
        <a href="/blog" class="inline-block">

        <button class="group shadow relative size-40 flex items-center justify-center transition-transform hover:scale-110 active:scale-95">
            <!-- The Heart Shape (Background) -->
            <svg class="absolute inset-0 w-full h-full fill-red-500 group-hover:fill-red-400 transition-colors drop-shadow-lg" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            
            <!-- The Text (Foreground) -->
            <span class="relative z-10 text-white font-bold text-lg">blogs</span>
        </button>

        </a>

    </div>

</div>
